@page "/weather"
@rendermode InteractiveServer
@using System.Linq
@using Microsoft.AspNetCore.Components.Web



<h1>Weather forecast</h1>

<p>This component demonstrates fetching data from a service.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-3">
        <label>Filtruj po nazwie:</label>
        <input class="form-control" @oninput="@Input" placeholder="Wpisz fragment opisu..." />
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Temp. (C)</th>
                <th>Temp. (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>

    <p role="status">Liczba ciepłych dni (>15°C): @warmDays</p>

    <button class="btn btn-primary" @onclick="WarmDaysFilter">Pokaż tylko ciepłe dni</button>
    <button class="btn btn-secondary" @onclick="Restore">Restore</button>
}

@code {
    private WeatherForecast[]? forecasts;
    private WeatherForecast[]? originalForecasts; 
    private int warmDays;

    protected override async Task OnInitializedAsync()
    {
        // Symulacja pobierania danych
        await Task.Delay(500);

        var startDate = DateOnly.FromDateTime(DateTime.Now);
        var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching" };
        
        //wydłużenie prognozy do 10 dni
        forecasts = Enumerable.Range(1, 10).Select(index => new WeatherForecast
        {
            Date = startDate.AddDays(index),
            TemperatureC = Random.Shared.Next(-20, 55),
            Summary = summaries[Random.Shared.Next(summaries.Length)]
        }).ToArray();

        originalForecasts = forecasts;
        CountWarmDays();
    }

    //zliczanie ciepłych dni
    private void CountWarmDays()
    {
        if (forecasts != null)
        {
            warmDays = forecasts.Count(f => f.TemperatureC > 15);
        }
    }

    //filtrowanie po temperaturze
    private void WarmDaysFilter()
    {
        if (forecasts != null)
        {
            forecasts = forecasts.Where(f => f.TemperatureC > 15).ToArray();
        }
    }

    //przywracanie danych
    private void Restore()
    {
        forecasts = originalForecasts;
    }

    //filtrowanie po nazwie
    private void Input(ChangeEventArgs arg)
    {
        string searchTerm = arg.Value?.ToString() ?? "";
        if (originalForecasts != null)
        {
            forecasts = originalForecasts
                .Where(f => f.Summary != null && f.Summary.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }
    }

    private class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}